# Normalize text so Windows and macOS/Linux agents produce stable diffs.
* text=auto

*.cs       text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.shader   text eol=lf
*.asmdef   text eol=lf

# Common binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.glb  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
